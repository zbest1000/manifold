{
 "uid": "manifold-overview",
 "title": "Manifold Overview",
 "description": "Manifold + demo stack observability: broker ingest, canary round-trips, server CPU/memory/event-loop, per-container resources via cAdvisor, and DataOps throughput.",
 "tags": [
  "manifold",
  "mqtt",
  "uns"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 4,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 100,
   "type": "row",
   "title": "Live traffic",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 1,
   "type": "timeseries",
   "title": "Broker ingest rate (msgs/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "manifold-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "color": {
      "mode": "palette-classic"
     },
     "unit": "mps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(manifold_broker_messages_received_total[1m])",
     "legendFormat": "{{broker}}",
     "datasource": {
      "type": "prometheus",
      "uid": "manifold-prom"
     }
    }
   ],
   "description": "Messages per second Manifold receives from each connected broker."
  },
